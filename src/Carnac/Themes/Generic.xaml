<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Carnac.UI">

    <Style TargetType="{x:Type ui:PreferencesField}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:PreferencesField}">
                    <Border Background="Transparent" BorderBrush="#2E2E34" BorderThickness="0,0,0,1" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="176" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#12FFFFFF" BorderBrush="#2E2E34" BorderThickness="0,0,1,0"
                                    Padding="14,11,12,11">
                                <TextBlock VerticalAlignment="Top" Margin="0,2,0,0"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#ECECF0" TextWrapping="Wrap"
                                           Text="{TemplateBinding Header}" />
                            </Border>

                            <Border Grid.Column="1" Padding="14,10,14,10">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>

                            <Border x:Name="SecondaryHost" Grid.Column="2" Width="82" Padding="0,9,14,9" VerticalAlignment="Top">
                                <ContentPresenter Content="{TemplateBinding SecondaryControl}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SecondaryControl" Value="{x:Null}">
                            <Setter TargetName="SecondaryHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
