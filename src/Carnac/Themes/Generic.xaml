<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Carnac.UI">

    <Style TargetType="{x:Type ui:PreferencesField}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:PreferencesField}">
                    <Border BorderBrush="#33FFFFFF" BorderThickness="0,0,0,1" Padding="0,7" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="165" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="#26FFFFFF" BorderThickness="0,0,1,0" Padding="6,0,10,0">
                                <TextBlock VerticalAlignment="Top" Margin="0,2,0,0" FontWeight="Bold"
                                           Foreground="White" TextWrapping="Wrap"
                                           Text="{TemplateBinding Header}" />
                            </Border>

                            <ContentPresenter Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" />

                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding SecondaryControl}"
                                              VerticalAlignment="Top" Margin="0" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
