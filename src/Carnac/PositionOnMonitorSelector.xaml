<UserControl x:Class="Carnac.PositionOnMonitorSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:Carnac.UI"
             xmlns:utilities="clr-namespace:Carnac.Utilities"
             mc:Ignorable="d"
             x:Name="ScreenSelector" d:DataContext="{d:DesignInstance ui:PreferencesViewModel}">
    <UserControl.Resources>
        <utilities:PlacementMarginConverter x:Key="PlacementMarginConverter" />
        <Style x:Key="PlacementButton" TargetType="{x:Type RadioButton}">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="OuterBorder" Width="32" Height="28" CornerRadius="4"
                                Background="#1FFFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1.2">
                            <Grid>
                                <Path x:Name="Check" Margin="5,5,5,5" Stretch="Uniform"
                                      Fill="#70FFFFFF"
                                      Data="M0,1 22,1 22,4 0,4Z M0,7 19,7 19,10 0,10Z M0,13 16,13 16,16 0,16Z" />
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="#3838A3F1" />
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#9938A3F1" />
                                <Setter TargetName="Check" Property="Fill" Value="#E6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="#0E639C" />
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#66C2FF" />
                                <Setter TargetName="OuterBorder" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Check" Property="Fill" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ItemsControl VerticalAlignment="Top" HorizontalAlignment="Center" Focusable="False"
                  Background="{x:Null}" BorderBrush="{x:Null}" Foreground="White"
                  ItemsSource="{Binding Screens}">
        <ItemsControl.Style>
            <Style>
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                </Style.Resources>
            </Style>
        </ItemsControl.Style>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel IsItemsHost="True" Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="10,4,10,4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                    <Border CornerRadius="6" BorderBrush="#4C9EEB" BorderThickness="2" Padding="2"
                            Background="#132942" SnapsToDevicePixels="True">
                        <Grid Width="{Binding RelativeWidth}" Height="{Binding RelativeHeight}" Margin="0">
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1A3B5C" Offset="0" />
                                        <GradientStop Color="#0F2338" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="54"
                                       FontWeight="Light" Foreground="#40FFFFFF" Text="{Binding Index}" />
                            <RadioButton x:Name="rbTL" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Checked="RadioChecked" Content="" GroupName="Placement"
                                         IsChecked="{Binding NotificationPlacementTopLeft}"
                                         Style="{StaticResource PlacementButton}" Tag="{Binding}">
                                <RadioButton.Margin>
                                    <MultiBinding Converter="{StaticResource PlacementMarginConverter}">
                                        <Binding Path="DataContext.Settings.Margins"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="DataContext.SelectedScreen"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </RadioButton.Margin>
                            </RadioButton>
                            <RadioButton x:Name="rbBL" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Checked="RadioChecked" Content="" GroupName="Placement"
                                         IsChecked="{Binding NotificationPlacementBottomLeft}"
                                         Style="{StaticResource PlacementButton}" Tag="{Binding}">
                                <RadioButton.Margin>
                                    <MultiBinding Converter="{StaticResource PlacementMarginConverter}">
                                        <Binding Path="DataContext.Settings.Margins"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="DataContext.SelectedScreen"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </RadioButton.Margin>
                            </RadioButton>
                            <RadioButton x:Name="rbTR" HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Checked="RadioChecked" Content="" GroupName="Placement"
                                         IsChecked="{Binding NotificationPlacementTopRight}"
                                         Style="{StaticResource PlacementButton}" Tag="{Binding}">
                                <RadioButton.Margin>
                                    <MultiBinding Converter="{StaticResource PlacementMarginConverter}">
                                        <Binding Path="DataContext.Settings.Margins"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="DataContext.SelectedScreen"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </RadioButton.Margin>
                            </RadioButton>
                            <RadioButton x:Name="rbBR" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Checked="RadioChecked" Content="" GroupName="Placement"
                                         IsChecked="{Binding NotificationPlacementBottomRight}"
                                         Style="{StaticResource PlacementButton}" Tag="{Binding}">
                                <RadioButton.Margin>
                                    <MultiBinding Converter="{StaticResource PlacementMarginConverter}">
                                        <Binding Path="DataContext.Settings.Margins"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="DataContext.SelectedScreen"
                                                 Source="{x:Reference ScreenSelector}" />
                                        <Binding Path="IsChecked" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </RadioButton.Margin>
                            </RadioButton>
                        </Grid>
                    </Border>
                    <Border Width="42" Height="3" CornerRadius="1.5" Background="#484852" Margin="0,3,0,5" HorizontalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#ECECF0"
                               Text="{Binding FriendlyName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               MaxWidth="{Binding RelativeWidth}" ToolTip="{Binding FriendlyName}" />
                    <TextBlock HorizontalAlignment="Center" FontSize="11.5" Foreground="#9A9AA2" Margin="0,1,0,0">
                        <Run Text="{Binding Width}" /><Run Text=" × " /><Run Text="{Binding Height}" />
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>