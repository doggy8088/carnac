<controls:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:ui="clr-namespace:Carnac.UI"
                      xmlns:utilities="clr-namespace:Carnac.Utilities"
                      xmlns:carnac="clr-namespace:Carnac"
                      x:Class="Carnac.UI.PreferencesView"
                      Width="660" Height="760" MinWidth="630" MinHeight="620" Icon="../icon.ico"
                      Foreground="{DynamicResource BlackBrush}"
                      d:DataContext="{d:DesignInstance ui:PreferencesViewModel}" mc:Ignorable="d"
                      ShowTitleBar="False" ShowMinButton="False" ShowMaxRestoreButton="False"
                      SaveWindowPosition="True" utilities:DesignTimeHelper.Background="Black"
                      Name="PreferencesViewWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary
                    Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.AnimatedSingleRowTabControl.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/Blue.xaml" />
                <ResourceDictionary
                    Source="pack://application:,,,/MahApps.Metro;component/Styles/Accents/BaseDark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ColourPickerTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch"
                                d:DataContext="{d:DesignInstance ui:AvailableColor}">
                    <TextBlock Width="20"
                                   Height="20"
                                   Margin="2"
                                   VerticalAlignment="Stretch"
                                   Background="{Binding Brush}" />
                    <TextBlock Margin="2"
                                   VerticalAlignment="Stretch"
                                   Text="{Binding Name}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="General">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,0,0,0" Orientation="Vertical">
                            <carnac:PositionOnMonitorSelector />
                            <ui:PreferencesField Header="Top Offset">
                                <Slider Value="{Binding Settings.TopOffset}" IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                Maximum="{Binding SelectedScreen.Height}" Minimum="0" SmallChange="1" TickFrequency="20" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.TopOffset}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Bottom Offset">
                                <Slider Value="{Binding Settings.BottomOffset}" IsSnapToTickEnabled="True" LargeChange="10"
                                Maximum="{Binding SelectedScreen.Height}" Minimum="0" SmallChange="1" TickFrequency="20" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.BottomOffset}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Left Offset">
                                <Slider Value="{Binding Settings.LeftOffset}" IsSnapToTickEnabled="True" LargeChange="10"
                                Maximum="{Binding SelectedScreen.Width}" Minimum="0" SmallChange="1" TickFrequency="20" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.LeftOffset}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Right Offset">
                                <Slider Value="{Binding Settings.RightOffset}" IsSnapToTickEnabled="True" LargeChange="10"
                                Maximum="{Binding SelectedScreen.Width}" Minimum="0" SmallChange="1" TickFrequency="20" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.RightOffset}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Auto Update">
                                <CheckBox IsChecked="{Binding Settings.AutoUpdate}" Content="auto check updates from GitHub (need to restart this program)" />
                            </ui:PreferencesField>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="1" Margin="5">
                        <Button Width="150" Margin="0 0 5 0" Content="Reset to Defaults" Command="{Binding ResetToDefaultsCommand}" />
                        <Button Width="50" Content="Save" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Appearance">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,0,0,0" Orientation="Vertical">
                            <ui:PreferencesField Header="Popup Text Width">
                                <Slider IsSnapToTickEnabled="True" Value="{Binding Settings.ItemMaxWidth}"
                                LargeChange="50" Maximum="1000" Minimum="0" SmallChange="10" TickFrequency="10" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.ItemMaxWidth}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Popup Opacity">
                                <Slider Value="{Binding Settings.ItemOpacity}" IsSnapToTickEnabled="True"
                                LargeChange="0.1" Maximum="1" Minimum="0" SmallChange="0.05" TickFrequency="0.05" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.ItemOpacity}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Popup Fade Delay (sec)">
                                <Slider Value="{Binding Settings.ItemFadeDelay}" IsSnapToTickEnabled="True"
                                LargeChange="2" Maximum="50" Minimum="1" SmallChange="1" TickFrequency="1" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.ItemFadeDelay}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Font Size">
                                <Slider Value="{Binding Settings.FontSize}" IsSnapToTickEnabled="True"
                                LargeChange="2" Maximum="48" Minimum="8" SmallChange="1" TickFrequency="1" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.FontSize}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Font Color">
                                <ComboBox SelectedItem="{Binding FontColor}"
                                  ItemsSource="{Binding AvailableColors}"
                                  ItemTemplate="{StaticResource ColourPickerTemplate}" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Background Color">
                                <ComboBox SelectedItem="{Binding ItemBackgroundColor}"
                                  ItemsSource="{Binding AvailableColors}"
                                  ItemTemplate="{StaticResource ColourPickerTemplate}" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Shortcuts Only">
                                <CheckBox IsChecked="{Binding Settings.DetectShortcutsOnly}" Content="Only show keys that are listed in the Keymaps folder" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Only keys with Modifiers">
                                <CheckBox IsChecked="{Binding Settings.ShowOnlyModifiers}" Content="Only show keys that have Ctrl, Shift, Alt or Windows"
                                          ToolTip="Shift only counts for keys that do not type a character: Shift+Enter, Shift+Tab, Shift+F5 and Shift+arrows are shown, Shift+A (a capital A) is not." />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Modifier Keys">
                                <CheckBox IsChecked="{Binding Settings.ShowModifierKeyPresses}" Content="Show Ctrl, Alt and Windows pressed on their own" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Keys to show">
                                <StackPanel Orientation="Vertical">
                                    <ItemsControl ItemsSource="{Binding KeyCategoryOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Margin="0 0 12 4" IsChecked="{Binding IsSelected}" Content="{Binding Label}" ToolTip="{Binding Description}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,4,0,0" Foreground="#B8FFFFFF" HorizontalAlignment="Left" TextWrapping="Wrap"
                                               Text="Keys pressed with Ctrl, Alt or Windows and shortcuts from the Keymaps are always shown. The two options above are applied on top of these boxes, so they can only hide more." />
                                </StackPanel>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Ignored Keys">
                                <StackPanel Orientation="Vertical">
                                    <TextBox Text="{Binding Settings.IgnoredKeys}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinLines="2" MaxLines="4" VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#B8FFFFFF" HorizontalAlignment="Left" TextWrapping="Wrap"
                                               Text="Keys that are never shown, separated by commas or new lines, for example W,A,S,D or Ctrl+Alt+Delete. The modifiers must match: W does not hide Ctrl+W or Shift+W. An ignored key can still complete a shortcut from a keymap." />
                                </StackPanel>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Show Space as ␣">
                                <CheckBox IsChecked="{Binding Settings.ShowSpaceAsUnicode}" Content="Show Space as Unicode character '␣'" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Keyboard Layout">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox IsChecked="{Binding Settings.UseKeyboardLayoutNames}" IsEnabled="{Binding IsKeyboardLayoutSupported, Mode=OneTime}" Content="Show keys as on my keyboard layout" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#B8FFFFFF" TextWrapping="Wrap">Needs Windows 10 version 1607 or later.</TextBlock>
                                </StackPanel>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Repeated Keys">
                                <ComboBox ItemsSource="{Binding RepeatedKeyGroupingOptions}"
                                          DisplayMemberPath="Value" SelectedValuePath="Key"
                                          SelectedValue="{Binding Settings.RepeatedKeyGrouping}"
                                          ToolTip="Named keys, arrows and shortcuts are always shown as 'x N' when repeated" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Group Repeats From">
                                <Slider Value="{Binding Settings.RepeatedKeyThreshold}" IsSnapToTickEnabled="True"
                                LargeChange="1" Maximum="10" Minimum="2" SmallChange="1" TickFrequency="1"
                                ToolTip="Number of presses in a row from which a typed character is shown as 'x N'" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBox Foreground="White" Text="{Binding Settings.RepeatedKeyThreshold}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Show Application Icon">
                                <CheckBox IsChecked="{Binding Settings.ShowApplicationIcon}" Content="Display the active application's icon" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Shortcut Descriptions">
                                <CheckBox IsChecked="{Binding Settings.ShowShortcutDescription}" Content="Show shortcut descriptions from keymaps" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Process Filter">
                                <StackPanel Orientation="Vertical">
                                    <TextBox Text="{Binding Settings.ProcessFilterExpression}"></TextBox>
                                    <TextBlock Margin="0,4,0,0" Foreground="#B8FFFFFF" HorizontalAlignment="Left" TextWrapping="Wrap">
                                        <Run Text="Only show keys from processes whose name matches this regular expression (case-insensitive, matches part of the name). Use the process name without .exe, as listed in Task Manager on the Details tab." /><LineBreak />
                                        <Run FontFamily="Consolas" Text="notepad|calc" /><Run Text=" - names containing notepad or calc" /><LineBreak />
                                        <Run FontFamily="Consolas" Text="^(notepad|calc)$" /><Run Text=" - exactly these two applications" /><LineBreak />
                                        <Run FontFamily="Consolas" Text="^(?!ZoomIt64$)" /><Run Text=" - every application except ZoomIt" />
                                    </TextBlock>
                                </StackPanel>
                            </ui:PreferencesField>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="1" Margin="5">
                        <Button Width="150" Margin="0 0 5 0" Content="Reset to Defaults" Command="{Binding ResetToDefaultsCommand}" />
                        <Button Width="50" Content="Save" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>

            </TabItem>
            <TabItem Header="Mouse">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,0,0,0" Orientation="Vertical">
                            <ui:PreferencesField Header="Show Mouse Clicks">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox IsChecked="{Binding Settings.ShowMouseClicks}" Content="Circle around the pointer on mouse clicks" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#B8FFFFFF" HorizontalAlignment="Left" TextWrapping="Wrap">The circles are also shown in password mode.</TextBlock>
                                </StackPanel>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Left Button">
                                <ComboBox SelectedItem="{Binding LeftClickColor}"
                                  ItemsSource="{Binding AvailableColors}"
                                  ItemTemplate="{StaticResource ColourPickerTemplate}" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Middle Button">
                                <ComboBox SelectedItem="{Binding MiddleClickColor}"
                                  ItemsSource="{Binding AvailableColors}"
                                  ItemTemplate="{StaticResource ColourPickerTemplate}" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Right Button">
                                <ComboBox SelectedItem="{Binding RightClickColor}"
                                  ItemsSource="{Binding AvailableColors}"
                                  ItemTemplate="{StaticResource ColourPickerTemplate}" />
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Circle Size">
                                <Slider Value="{Binding Settings.ClickCircleSize}" IsSnapToTickEnabled="True"
                                    LargeChange="20" Maximum="200" Minimum="20" SmallChange="5" TickFrequency="5" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBlock Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Settings.ClickCircleSize}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                            <ui:PreferencesField Header="Circle Duration (ms)">
                                <Slider Value="{Binding Settings.ClickCircleDuration}" IsSnapToTickEnabled="True"
                                    LargeChange="500" Maximum="3000" Minimum="100" SmallChange="100" TickFrequency="100" />
                                <ui:PreferencesField.SecondaryControl>
                                    <TextBlock Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Settings.ClickCircleDuration}" />
                                </ui:PreferencesField.SecondaryControl>
                            </ui:PreferencesField>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="1" Margin="5">
                        <Button Width="150" Margin="0 0 5 0" Content="Reset to Defaults" Command="{Binding ResetToDefaultsCommand}" />
                        <Button Width="50" Content="Save" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="About">
                <StackPanel Margin="20,40,0,0" Orientation="Horizontal">
                    <StackPanel Width="340">
                        <TextBlock Margin="0,-7,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               FontFamily="Segoe UI Light" FontSize="18.667" Foreground="#FF41B1E1" TextWrapping="Wrap">
                        <Run Text="a code52 project" />
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Left" FontFamily="Segoe UI Light" FontSize="20"
                               Foreground="White" Text="a project by" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Foreground="White" Text="{Binding Authors}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left" FontFamily="Segoe UI Light" FontSize="20"
                               Foreground="White" TextWrapping="Wrap">
                        <Run Text="Carnac uses" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" Foreground="White" Text="{Binding Components}" TextWrapping="Wrap" />
                        <Button Width="145" Margin="0,60,0,0" HorizontalAlignment="Center" Command="{Binding VisitCommand}"
                            Content="Visit Carnac Website" Style="{DynamicResource SquareButtonStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <Image Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Source="/Carnac;component/carnac_2.png" Stretch="UniformToFill" />
                        <TextBlock Margin="-4,0,0,0" HorizontalAlignment="Left" FontSize="69.333" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap">
                        <Run Text="Carnac" />
                        </TextBlock>
                        <TextBlock Height="20.83" Margin="0,-10,0,0" HorizontalAlignment="Left" FontWeight="Bold"
                               Foreground="White" TextWrapping="Wrap">
                        <Run Text="version " /><Run Text=" " /><Run Text="{Binding Version, Mode=OneTime}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</controls:MetroWindow>
